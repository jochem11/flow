    { "name": "int", "aliases": ["integer", "short", "byte"], "in": ["number", "int", "int", "int", "Int", "i32", "int"] },
    { "name": "long", "aliases": ["bigint"], "in": ["number", "long", "long", "int", "Long", "i64", "int64"] },
    { "name": "double", "aliases": ["float", "real", "number"], "in": ["number", "double", "double", "float", "Double", "f64", "float64"] },
    { "name": "decimal", "aliases": ["money", "bigdecimal"], "in": ["number", "BigDecimal", "decimal", "Decimal", "BigDecimal", "f64", "float64"] },
    { "name": "bool", "aliases": ["boolean"], "in": ["boolean", "boolean", "bool", "bool", "Boolean", "bool", "bool"] },
    { "name": "string", "aliases": ["str", "text", "char"], "in": ["string", "String", "string", "str", "String", "String", "string"] },
    { "name": "date", "aliases": [], "in": ["Date", "LocalDate", "DateOnly", "date", "LocalDate", "String", "time.Time"] },
    { "name": "datetime", "aliases": ["timestamp", "instant"], "in": ["Date", "LocalDateTime", "DateTime", "datetime", "LocalDateTime", "String", "time.Time"] },
    { "name": "time", "aliases": [], "in": ["string", "LocalTime", "TimeOnly", "time", "LocalTime", "String", "time.Time"] },
    { "name": "duration", "aliases": ["timespan"], "in": ["number", "Duration", "TimeSpan", "timedelta", "Duration", "std::time::Duration", "time.Duration"] },
    { "name": "uuid", "aliases": ["guid"], "in": ["string", "UUID", "Guid", "UUID", "UUID", "String", "string"] },
    { "name": "bytes", "aliases": ["binary", "blob"], "in": ["Uint8Array", "byte[]", "byte[]", "bytes", "ByteArray", "Vec<u8>", "[]byte"] },
    { "name": "void", "aliases": [], "in": ["void", "void", "void", "None", "Unit", "()", ""] },
