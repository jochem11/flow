# The frontend in development (`npm run dev`, `npm run app:dev`, `npm run app:build:dev`).
# Only VITE_* reaches the app; nothing secret goes here (this file is committed).

# The server the desktop app talks to (the web version always uses its own origin)
VITE_SERVER_URL=http://localhost:8080
# Links into the desktop app: Flow Dev has its own scheme, so links from a dev
# server open Flow Dev and not the normal Flow
VITE_DESKTOP_SCHEME=flowapp-dev
