# Copy to server/.env and fill in. See server/src/config.rs for all settings.
# Include your user name: postgres://<user>@localhost/flow
DATABASE_URL=postgres://localhost/flow
PUBLIC_URL=http://localhost:8080
# The web build, after `npm run build`
WEB_DIR=../dist
# Write mails to this folder instead of sending them (development)
MAIL_OUTBOX=./outbox
# Links into the desktop app open Flow Dev (`npm run app:dev`), not the normal Flow
DESKTOP_SCHEME=flowapp-dev
# Google sign-in: https://console.cloud.google.com/apis/credentials → OAuth client ID (Web application),
# authorized redirect URI: <PUBLIC_URL>/api/auth/google/callback
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=
# Sending mail for real
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASSWORD=
#MAIL_FROM=Flow <no-reply@example.com>
