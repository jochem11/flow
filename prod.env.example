# Settings for production (docker-compose.prod.yml). Copy this file to prod.env
# and fill it in. prod.env is not committed (it holds passwords).

# ---------- Database ----------
# Make one with: openssl rand -hex 24   (letters and digits only: it goes in a URL)
# Only used the first time the database is made; changing it later needs a change in Postgres too.
POSTGRES_PASSWORD=

# ---------- Where people reach Flow ----------
# https:// makes the login cookies secure. On this Mac without a domain yet:
# http://localhost:8090 (only you), or http://<this Mac's IP>:8090 with FLOW_BIND=0.0.0.0
PUBLIC_URL=https://flow.example.com
#FLOW_BIND=127.0.0.1
#FLOW_PORT=8090
# Behind a proxy or tunnel (the default here) the client's address comes from
# X-Forwarded-For, for rate limits. Reached directly (FLOW_BIND=0.0.0.0, no proxy): 0
#TRUST_PROXY=1

# ---------- Mail (required: confirmation, password reset, invitations) ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Flow <you@gmail.com>

# ---------- Google sign-in (optional) ----------
# Add <PUBLIC_URL>/api/auth/google/callback as an authorized redirect URI
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Cloudflare Tunnel (optional) ----------
# Cloudflare dashboard → Zero Trust → Networks → Tunnels → create one, copy its token,
# and add a public hostname (your PUBLIC_URL's host) pointing to http://flow:8080
#COMPOSE_PROFILES=tunnel
#TUNNEL_TOKEN=
