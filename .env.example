# Settings for `docker compose up`. Copy this file to `.env` (next to docker-compose.yml)
# and fill in what you use. `.env` is not committed (it holds passwords).

# ---------- Mail (sign-up confirmation, password reset, invitations) ----------
# With Gmail: turn on 2-step verification for your Google account, then make an
# app password at https://myaccount.google.com/apppasswords and paste it below
# (16 letters, spaces don't matter). Gmail sends up to about 500 mails a day.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
MAIL_FROM=Flow <you@gmail.com>

# ---------- Google sign-in ----------
# https://console.cloud.google.com → make a project → "APIs & Services":
#   1. OAuth consent screen: User type "External", fill in the app name and your email;
#      while it is "Testing", add every Google account that may log in under "Test users".
#   2. Credentials → Create credentials → OAuth client ID → "Web application";
#      Authorized redirect URI: http://localhost:8080/api/auth/google/callback
#      (on a real server: https://<your domain>/api/auth/google/callback)
#   3. Paste the client ID and secret here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Your own database (optional) ----------
# Without this, Flow uses the PostgreSQL that docker-compose.yml starts. With it:
#   docker compose up -d --build --no-deps flow
# A database on this computer is "host.docker.internal" from inside Docker (not localhost).
# Hosted databases (Neon, Supabase, RDS, ...) usually want "?sslmode=require" at the end.
#DATABASE_URL=postgres://user:password@host.docker.internal:5432/flow

# Where people reach Flow (links in mails, the Google redirect)
PUBLIC_URL=http://localhost:8080
