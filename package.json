{
  "name": "flowapp",
  "version": "0.1.0",
  "description": "",
  "type": "module",
  "scripts": {
    "start": "vite",
    "start:dev": "scripts/dev.sh",
    "start:dev:web": "scripts/dev.sh web",
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "serve": "vite preview",
    "tauri": "tauri",
    "app:dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "app:build": "tauri build",
    "app:build:dev": "tauri build --config src-tauri/tauri.dev.conf.json",
    "server:dev": "docker compose up --build",
    "server:prod": "docker compose -f docker-compose.prod.yml --env-file prod.env up -d --build",
    "server:prod:logs": "docker compose -f docker-compose.prod.yml --env-file prod.env logs -f flow",
    "server:prod:stop": "docker compose -f docker-compose.prod.yml --env-file prod.env down",
    "bindings": "cd src-tauri && cargo test export_bindings",
    "test": "vitest run"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-deep-link": "^2.6.3",
    "@tauri-apps/plugin-opener": "^2",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-collaboration": "^3.31.4",
    "@tiptap/extension-collaboration-caret": "^3.31.4",
    "@tiptap/extension-list": "3.31.4",
    "@tiptap/extensions": "3.31.4",
    "@tiptap/markdown": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@tiptap/y-tiptap": "^3.0.11",
    "lucide": "1.57.0",
    "markdown-it": "^14.3.3",
    "solid-js": "^1.9.3",
    "y-protocols": "^1.0.7",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/markdown-it": "^14.2.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^3.2.7"
  }
}
